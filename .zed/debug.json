// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug acme-webui",
    "build": { "command": "cargo", "args": ["build"] },
    "program": "$ZED_WORKTREE_ROOT/target/debug/acme-webui.exe",
    "args": ["-h", "127.0.0.1", "-p", "6980"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "RUST_LOG": "debug" },
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
    "preTerminateCommands": ["cd web && bun run build"],
  },
]
